# ==========================================
# PalMind Environment Configuration
# 100% Private Local AI Memory Companion
# ==========================================

# Application Environment
APP_ENV=development
DEBUG=True

# Database Storage (SQLite by default for zero-config local operation)
DATABASE_URL=sqlite:///./data/palmind.db

# Local AI Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60.0

# Local Dense Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage & Upload Limits
MAX_UPLOAD_MB=25

# Frontend Port Configuration (for Vite)
VITE_API_URL=http://localhost:8000/api
